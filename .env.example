APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://mock_ai:mock_ai@localhost:5432/mock_ai?sslmode=disable
REDIS_URL=redis://:mock_ai@localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=mock_ai_admin
MINIO_ROOT_PASSWORD=replace-with-a-random-password
MINIO_BUCKET=mock-ai
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5173
AI_KEY_ENCRYPTION_KEY=
GEMINI_WRITING_MODEL=gemini-3.7-flash
# Stars are sold through this provider. "none" keeps sales closed ("coming soon").
PAYMENT_PROVIDER=none
GEMINI_SPEAKING_MODEL=gemini-3.7-flash
GEMINI_SPEAKING_VOICE_MODEL=gemini-3.8-flash-tts
GEMINI_SPEAKING_LIVE_MODEL=gemini-3.8-live
TELEGRAM_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
SESSION_SECRET=replace-with-at-least-32-random-bytes
